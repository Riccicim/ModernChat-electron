<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chat Sayfası</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- Tailwind Config -->
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              poppins: ['Poppins', 'sans-serif'],
            },
            colors: {
              'chat-bg': '#2d2f3e',
              'chat-box': '#393c4f',
              'chat-msg-sender': '#4c5c68',
            },
          }
        }
      };
    </script>

    <style>
        @keyframes modalSlide {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-modalSlide {
  animation: modalSlide 0.3s ease-out;
}
      body {
        background: linear-gradient(to bottom right, #1e3a8a, #0f172a);
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate-fadeInUp {
        animation: fadeInUp 1s ease-out both;
      }

      input[type="text"]::-webkit-inner-spin-button,
      input[type="text"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }

      input[type="text"] {
        -moz-appearance: textfield;
      }
    </style>
  </head>

  <body class="min-h-screen font-poppins flex">
    <!-- Sol Panel (Kullanıcı Listesi) -->
    <div class="bg-chat-bg w-[250px] h-screen p-4">
      <h2 class="text-white font-bold mb-4 text-center">Kullanıcılar</h2>
      
      <!-- Kullanıcı Listesi -->
      <div class="space-y-4">
        <!-- Kullanıcı 1 -->
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-blue-500 rounded-full"></div> <!-- Avatar -->
          <div class="text-white">
            <p class="font-semibold">Kullanıcı 1</p>
            <p class="text-xs text-green-500">Çevrimiçi</p>
          </div>
        </div>
        
        <!-- Kullanıcı 2 -->
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-red-500 rounded-full"></div> <!-- Avatar -->
          <div class="text-white">
            <p class="font-semibold">Kullanıcı 2</p>
            <p class="text-xs text-gray-500">Çevrimdışı</p>
          </div>
        </div>

        <!-- Kullanıcı 3 -->
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-green-500 rounded-full"></div> <!-- Avatar -->
          <div class="text-white">
            <p class="font-semibold">Kullanıcı 3</p>
            <p class="text-xs text-green-500">Çevrimiçi</p>
          </div>
        </div>
      </div>

      <!-- Alt Kısım (Kullanıcı Ayarları) -->
      <div class="absolute bottom-4 w-full p-4">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-gray-500 rounded-full"></div> <!-- Avatar -->
          <div class="text-white">
            <p class="font-semibold">Kullanıcı Adı</p>
            <button type="button" onclick="openModal()" class="text-xs text-white/80 bg-blue-500 hover:bg-blue-600 px-3 py-1 rounded-full transition-all duration-300 ease-in-out hover:scale-105 shadow-md">
                Ayarlar
              </button>
              <button type="button" onclick="openLogoutModal()" class="text-xs text-white/80 bg-red-500 hover:bg-red-600 px-3 py-1 rounded-full transition-all duration-300 ease-in-out hover:scale-105 shadow-md">
                Çıkış
              </button>          </div>
        </div>
      </div>
    </div>

  <!-- Profil Bilgileri Modal -->
<div id="settingsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
    <div class="rounded-xl shadow-xl w-[90%] max-w-md p-6 animate-modalSlide" style="background: linear-gradient(to bottom right, #1e3a8a, #0f172a);">
      <h2 class="text-2xl font-bold mb-4 text-center text-white">Profil Bilgileri</h2>
  
      <div class="flex flex-col items-center">
        <!-- Profil Fotoğrafı -->
        <img src="https://via.placeholder.com/100" alt="Profil Fotoğrafı" class="w-24 h-24 rounded-full border mb-4" />
  
        <!-- Kullanıcı Bilgileri -->
        <div class="w-full text-white space-y-3">
          <div>
            <span class="font-semibold">User Name:</span>
            <span class="ml-2">exampleUser</span>
          </div>
          <div>
            <span class="font-semibold">E-Mail:</span>
            <span class="ml-2">ornek@mail.com</span>
          </div>
          <div>
            <span class="font-semibold">User ID:</span>
            <span class="ml-2">123456789</span>
          </div>
          <div>
            <span class="font-semibold">Register Date:</span>
            <span class="ml-2">30 Jun. 2025</span>
          </div>
          <div>
            <span class="font-semibold">Thema:</span>
            <span class="ml-2">Dark</span>
          </div>
        </div>
      </div>
  
      <!-- Kapat Butonu -->
      <div class="flex justify-end mt-6">
        <button onclick="closeModal()" class="px-4 py-2 bg-white text-blue-700 hover:bg-blue-200 rounded-lg font-semibold transition">
          Kapat
        </button>
      </div>
    </div>
  </div>
  
  
    <!-- Chat Panel -->
    <div class="flex-1 bg-chat-box rounded-lg shadow-lg overflow-hidden animate-fadeInUp">
      <!-- Chat Header -->
     

      <!-- Messages -->
      <div class="h-[60vh] overflow-y-auto p-4 space-y-4">
        <!-- Sender Message -->
        <div class="flex justify-end space-x-3">
          <div class="flex flex-col items-end">
            <div class="text-sm text-gray-400">10:30</div>
            <div class="bg-blue-600 text-white p-8 rounded-lg max-w-[95%]">
              <div class="flex items-center space-x-4">
                <div class="w-14 h-14 bg-blue-500 rounded-full"></div> <!-- Avatar -->
                <span>Hi, What's up men?</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Receiver Message -->
        <div class="flex justify-start space-x-3">
          <div class="flex flex-col items-start">
            <div class="text-sm text-gray-400">10:31</div>
            <div class="bg-gray-800 text-white p-8 rounded-lg max-w-[95%]">
              <div class="flex items-center space-x-4">
                <div class="w-14 h-14 bg-green-500 rounded-full"></div> <!-- Avatar -->
                <span>I fine! you?</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Sender Message -->
        <div class="flex justify-end space-x-3">
          <div class="flex flex-col items-end">
            <div class="text-sm text-gray-400">10:32</div>
            <div class="bg-blue-600 text-white p-8 rounded-lg max-w-[95%]">
              <div class="flex items-center space-x-4">
                <div class="w-14 h-14 bg-blue-500 rounded-full"></div> <!-- Avatar -->
                <span>Me too!</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Çıkış Onayı Modal -->
<div id="logoutModal" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
    <div class="bg-white rounded-xl shadow-xl p-6 w-[90%] max-w-sm text-center animate-modalSlide">
      <h2 class="text-xl font-bold mb-4 text-gray-800">Are you sure you want to log out?      </h2>
      <p class="text-gray-600 mb-6">This will log you out.      </p>
      
      <div class="flex justify-center gap-4">
        <button onclick="closeLogoutModal()" class="px-4 py-2 bg-gray-300 hover:bg-gray-400 text-gray-800 rounded-lg transition">
          Cancel
        </button>
        <button onclick="confirmLogout()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition">
          Log Out
        </button>
      </div>
    </div>
  </div>

  
      <!-- Message Input -->
      <div class="bg-chat-bg p-4 flex items-center space-x-3 absolute bottom-0 w-full">
        <input type="text" placeholder="Mesajınızı buraya yazın..." class="w-full p-4 rounded-lg bg-white/20 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-blue-500" />
        <button class="bg-blue-600 hover:bg-blue-700 py-3 px-6 rounded-lg text-white font-semibold hover:scale-105 transition-all">
          Send
        </button>
      </div>
    </div>
  </body>
</html>

<script>
    function openModal() {
      document.getElementById("settingsModal").classList.remove("hidden");
      document.getElementById("settingsModal").classList.add("flex");
    }
  
    function closeModal() {
      document.getElementById("settingsModal").classList.remove("flex");
      document.getElementById("settingsModal").classList.add("hidden");
    }

      // Çıkış Modal
  function openLogoutModal() {
    document.getElementById('logoutModal').classList.remove('hidden');
  }
  function closeLogoutModal() {
    document.getElementById('logoutModal').classList.add('hidden');
  }
  function confirmLogout() {

    window.location.href = "/logout"; 
  }
  </script>